rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/imports/{alertId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['id'])
        && request.resource.data.id == alertId;
    }
    match /users/{userId}/alerts/{alertId} {
      function ownsAlerts() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validAlert() {
        let alert = request.resource.data;
        return alert.keys().hasAll(['id', 'createdAt', 'source', 'status', 'strength'])
          && alert.keys().hasOnly(['id', 'createdAt', 'source', 'status', 'strength'])
          && alert.id == alertId
          && alert.createdAt is string
          && alert.createdAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$')
          && alert.source == 'Movement'
          && alert.status in ['New', 'Reviewed']
          && (alert.strength == null || (alert.strength is number && alert.strength >= 0 && alert.strength <= 10000));
      }
      allow read, delete: if ownsAlerts();
      allow create: if ownsAlerts() && validAlert() && request.resource.data.status == 'New';
      allow update: if ownsAlerts() && validAlert()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
  }
}
